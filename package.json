{
  "name": "the-builder",
  "version": "0.5.0",
  "description": "A capability-aware, user-driven skill system for AI coding agents.",
  "type": "module",
  "engines": { "node": ">=18" },
  "bin": { "the-builder": "cli/bin/the-builder.js" },
  "files": ["skills", "adapters", "integrations", "core", "docs", "assets", "cli", "scripts", "README.md", "LICENSE", "CONTRIBUTING.md", "CHANGELOG.md", ".gitignore"],
  "scripts": {
    "validate": "python3 scripts/validate.py",
    "test": "python3 scripts/test_suite.py",
    "doctor": "node cli/bin/the-builder.js doctor",
    "list": "node cli/bin/the-builder.js list",
    "pack:test": "npm pack --dry-run"
  },
  "keywords": ["ai-agents", "agent-skills", "coding-agents", "skills", "mcp", "developer-tools"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Muhammad-Wasif-Qamar/The-Builder.git" },
  "bugs": { "url": "https://github.com/Muhammad-Wasif-Qamar/The-Builder/issues" },
  "homepage": "https://github.com/Muhammad-Wasif-Qamar/The-Builder"
}
